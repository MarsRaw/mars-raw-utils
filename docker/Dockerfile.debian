FROM rust:latest

ARG MRU_VERSION=0.10.0
ENV MRU_VERSION=${MRU_VERSION}

WORKDIR /mars

RUN cargo install cargo-deb
COPY . .

RUN cargo deb --package mru-cli

RUN ls -l target/debian/

# Validate installation package
RUN apt install ./target/debian/mru_${MRU_VERSION}-1_amd64.deb 

RUN mru -v update-cal-data

WORKDIR /data



